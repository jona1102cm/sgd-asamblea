# Environment
NODE_ENV=development

# Server
PORT=5000
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=sgd_asamblea
DB_DIALECT=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_URL=http://localhost:5000
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_FILES=10

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@asamblea.gob.ec

# Sendgrid (Alternative email service)
SENDGRID_API_KEY=your_sendgrid_api_key

# AWS Configuration (Optional - for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_TIMEOUT=3600000

# Report Generation
REPORT_TIMEOUT=30000
REPORT_OUTPUT_DIR=./reports

# Pagination
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100

# Feature Flags
ENABLE_TWO_FACTOR_AUTH=true
ENABLE_FILE_UPLOAD=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOG=true

# Notification Services
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=general

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
REQUIRE_STRONG_PASSWORD=true

# Application
APP_NAME=Sistema de Gestión de Documentos
APP_VERSION=1.0.0
APP_DESCRIPTION=Sistema integral de gestión de documentos para la Asamblea Nacional

# Debug
DEBUG=false
VERBOSE_LOGS=false
